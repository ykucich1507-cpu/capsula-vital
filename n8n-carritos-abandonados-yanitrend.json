    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst email = body?.email || '';\nconst phone = (body?.phone || body?.billing_address?.phone || body?.shipping_address?.phone || '').replace(/\\D/g, '');\nconst firstName = body?.customer?.first_name || body?.billing_address?.first_name || 'cliente';\nconst checkoutUrl = body?.abandoned_checkout_url || '';\nconst totalPrice = body?.total_price || '0';\n\n// Extraer primer producto del carrito\nconst lineItems = body?.line_items || [];\nconst producto = lineItems[0]?.title || 'tu producto';\nconst cantidad = lineItems[0]?.quantity || 1;\n\n// Solo procesar si hay email o teléfono\nconst tieneContacto = email || phone;\n\nreturn {\n  email,\n  phone,\n  firstName,\n  checkoutUrl,\n  totalPrice,\n  producto,\n  cantidad,\n  tieneContacto: !!tieneContacto,\n  lineItems\n};"
      },
      "id": "ca-0003",
