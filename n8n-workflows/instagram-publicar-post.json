{
  "name": "YaniTrend — Instagram Auto-Post Programado",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "triggerAtHour": 10, "triggerAtMinute": 0, "daysOfWeek": [1, 3, 5] },
            { "triggerAtHour": 18, "triggerAtMinute": 0, "daysOfWeek": [2, 4] }
          ]
        }
      },
      "id": "schedule",
      "name": "Horario de publicación",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": false,
        "limit": 1,
        "filters": {
          "formula": "AND({Publicado} = FALSE(), {Aprobado} = TRUE())"
        },
        "sort": {
          "property": [{ "field": "Fecha programada", "direction": "asc" }]
        }
      },
      "id": "airtable-get",
      "name": "Obtener próximo post de Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [480, 300],
      "notes": "Conectar tu base de Airtable con tabla: Contenido Instagram. Columnas: Imagen URL, Caption, Aprobado (checkbox), Publicado (checkbox), Fecha programada"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-hay-post",
      "name": "¿Hay post para publicar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.INSTAGRAM_ACCOUNT_ID }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $('Obtener próximo post de Airtable').item.json.fields['Imagen URL'] }}" },
            { "name": "caption", "value": "={{ $('Obtener próximo post de Airtable').item.json.fields['Caption'] }}" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        }
      },
      "id": "ig-create-container",
      "name": "Crear container en Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 220]
    },
    {
      "parameters": {
        "unit": "seconds",
        "amount": 30
      },
      "id": "wait",
      "name": "Esperar 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1180, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.INSTAGRAM_ACCOUNT_ID }}/media_publish",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $('Crear container en Instagram').item.json.id }}" },
            { "name": "access_token", "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}" }
          ]
        }
      },
      "id": "ig-publish",
      "name": "Publicar en Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 220]
    },
    {
      "parameters": {
        "operation": "update",
        "id": "={{ $('Obtener próximo post de Airtable').item.json.id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Publicado": true,
            "ID Instagram": "={{ $('Publicar en Instagram').item.json.id }}"
          }
        }
      },
      "id": "airtable-update",
      "name": "Marcar como publicado en Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1620, 220]
    }
  ],
  "connections": {
    "Horario de publicación": { "main": [[{ "node": "Obtener próximo post de Airtable", "type": "main", "index": 0 }]] },
    "Obtener próximo post de Airtable": { "main": [[{ "node": "¿Hay post para publicar?", "type": "main", "index": 0 }]] },
    "¿Hay post para publicar?": { "main": [[{ "node": "Crear container en Instagram", "type": "main", "index": 0 }], []] },
    "Crear container en Instagram": { "main": [[{ "node": "Esperar 30s", "type": "main", "index": 0 }]] },
    "Esperar 30s": { "main": [[{ "node": "Publicar en Instagram", "type": "main", "index": 0 }]] },
    "Publicar en Instagram": { "main": [[{ "node": "Marcar como publicado en Airtable", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["yanitrend", "instagram", "contenido"]
}
